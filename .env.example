# Public site URL used for canonical links, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://abdullahwagih.com

# --- Contact form email delivery (optional — pick ONE provider below) ---
# Without either provider configured, the contact form still validates input
# correctly but tells the visitor email delivery isn't set up yet and offers
# a mailto: fallback button instead of silently pretending to send.

# OPTION A — Gmail SMTP (recommended if you don't have a domain yet)
# Works immediately, no domain/DNS setup required. Emails arrive "from" your
# own Gmail address. Requires a Gmail App Password (not your regular Gmail
# password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OPTION B — Resend (https://resend.com)
# Requires a verified sending domain for reliable delivery — Resend's shared
# onboarding@resend.dev test address is restricted and will fail for most
# recipients. See README §5 for the full domain verification steps.
RESEND_API_KEY=
# Optional: the "From" address. Defaults to Resend's shared testing address.
# Only use a custom address here once its domain shows "Verified" in Resend:
# EMAIL_FROM="Abdullah Wagih <contact@yourdomain.com>"
EMAIL_FROM=

# Where contact form submissions are delivered, for either provider above.
# Defaults to abdullawagih1@gmail.com if unset.
CONTACT_TO_EMAIL=abdullawagih1@gmail.com
